---
export interface Milestone {
  label: string;
  state: "implemented" | "planned";
  detail?: string;
}

interface Props {
  milestones: Milestone[];
  /** Shown when nothing is implemented yet, instead of an empty column. */
  implementedEmpty?: string;
}

const { milestones, implementedEmpty } = Astro.props;

const implemented = milestones.filter((m) => m.state === "implemented");
const planned = milestones.filter((m) => m.state === "planned");
---

<div class={implemented.length > 0 ? "split" : "split single"}>
  {
    implemented.length > 0 && (
  <section class="group">
    <h3 class="eyebrow">Implemented</h3>
    {
      implemented.length > 0 ? (
        <ul>
          {implemented.map((m) => (
            <li>
              <span class="label">{m.label}</span>
              {m.detail && <span class="detail">{m.detail}</span>}
            </li>
          ))}
        </ul>
      ) : null
    }
  </section>
    )
  }

  <section class="group planned">
    <h3 class="eyebrow">Roadmap</h3>
    <ul>
      {
        planned.map((m) => (
          <li>
            <span class="label">{m.label}</span>
            {m.detail && <span class="detail">{m.detail}</span>}
          </li>
        ))
      }
    </ul>
  </section>
</div>

<style>
  .split {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  @media (min-width: 46rem) {
    .split {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }

    .split.single {
      grid-template-columns: 1fr;
    }
  }

  .group {
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5) var(--space-5);
    background: var(--paper-raised);
  }

  /* Roadmap items sit visually apart from shipped work. */
  .planned {
    background: transparent;
    border-style: dashed;
  }

  .eyebrow {
    margin-bottom: var(--space-3);
  }

  .planned .eyebrow {
    color: var(--status-development);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  li {
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .label {
    display: block;
    color: var(--ink);
    font-weight: 550;
  }

  .planned .label {
    color: var(--ink-muted);
    font-weight: 500;
  }

  .detail {
    display: block;
    color: var(--ink-muted);
    font-size: var(--text-xs);
    margin-top: 0.15em;
  }

  .empty {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    max-width: 48ch;
  }
</style>
