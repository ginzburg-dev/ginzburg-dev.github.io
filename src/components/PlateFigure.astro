---
/**
 * Figure for pre-rendered diagram artwork served from /public.
 *
 * Diagram artwork carries its own ground colour. The plate matches it rather
 * than recolouring finished artwork: `paper` for the light diagrams, `dark`
 * for artwork drawn on a dark background, in both themes.
 */
interface Props {
  src: string;
  alt: string;
  caption: string;
  credit?: string;
  /** Intrinsic size, so the browser reserves the right box before load. */
  width: number;
  height: number;
  tone?: "dark" | "paper";
}

const { src, alt, caption, credit, width, height, tone = "paper" } = Astro.props;
---

<figure>
  <div class={`plate ${tone}`}>
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
  <figcaption>
    <span>{caption}</span>
    {credit && <span class="credit" set:html={credit} />}
  </figcaption>
</figure>

<style>
  figure {
    margin: 0;
  }

  .plate {
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    overflow-x: auto;
  }

  .dark {
    background: #10131a;
    border-color: #262b36;
  }

  .paper {
    background: var(--paper-raised);
  }

  img {
    width: 100%;
    height: auto;
    min-width: 30rem;
    margin-inline: auto;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .credit {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }
</style>
