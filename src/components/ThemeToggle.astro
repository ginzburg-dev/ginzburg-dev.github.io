---
/* The site is dark by default; the toggle stores either explicit theme. */
---

<button type="button" class="toggle" data-theme-toggle aria-live="polite">
  <span class="visually-hidden">Switch colour theme</span>
  <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.6v2.3M12 19.1v2.3M2.6 12h2.3M19.1 12h2.3M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6" stroke-linecap="round"></path>
  </svg>
  <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
    <path d="M20.5 14.6A8.6 8.6 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1Z" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  .toggle {
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--ink-muted);
    cursor: pointer;
  }

  .toggle:hover {
    color: var(--ink);
    border-color: var(--rule);
    background: var(--paper-raised);
  }

  .icon {
    width: 1.05rem;
    height: 1.05rem;
    grid-area: 1 / 1;
  }

  /* Show the icon for the theme the button would switch *to*. */
  .sun {
    display: none;
  }

  :root[data-theme="dark"] .sun {
    display: block;
  }
  :root[data-theme="dark"] .moon {
    display: none;
  }
</style>

<script>
  const root = document.documentElement;

  function activeTheme(): "light" | "dark" {
    return root.dataset.theme === "dark" ? "dark" : "light";
  }

  function label(next: "light" | "dark") {
    return `Switch to ${next} theme`;
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]",
  )) {
    const sync = () => {
      const next = activeTheme() === "dark" ? "light" : "dark";
      button.setAttribute("title", label(next));
      const sr = button.querySelector(".visually-hidden");
      if (sr) sr.textContent = label(next);
    };

    button.addEventListener("click", () => {
      const next = activeTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        /* storage unavailable: the choice simply does not persist */
      }
      sync();
    });

    sync();
  }
</script>
