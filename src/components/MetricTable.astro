---
interface Column {
  label: string;
  numeric?: boolean;
}

interface Row {
  cells: (string | number)[];
  /** Marks the row for this project's own method. */
  own?: boolean;
}

interface Props {
  title?: string;
  /**
   * Methodology note. Rendered immediately next to the table, never deferred
   * to the end of the page, so no number is ever read without its conditions.
   */
  note: string;
  columns: Column[];
  rows: Row[];
}

const { title, note, columns, rows } = Astro.props;
---

<div class="metrics">
  {title && <p class="title">{title}</p>}
  <p class="note">{note}</p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          {
            columns.map((column) => (
              <th scope="col" class={column.numeric ? "num" : undefined}>
                {column.label}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class={row.own ? "own" : undefined}>
              {row.cells.map((cell, index) => (
                <td class={columns[index]?.numeric ? "num" : undefined}>
                  {cell}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .metrics {
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5) var(--space-2);
    background: var(--paper-raised);
  }

  .title {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--ink);
  }

  .note {
    font-size: var(--text-xs);
    line-height: 1.55;
    color: var(--ink-muted);
    margin-top: var(--space-1);
    margin-bottom: var(--space-3);
    max-width: 70ch;
  }

  table {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  th,
  td {
    border-bottom-color: var(--rule);
  }

  .num {
    text-align: right;
  }

  .own td {
    font-weight: 650;
    color: var(--ink);
    background: var(--accent-faint);
  }
</style>
