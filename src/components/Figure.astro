---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Required: a figure without an explanation is not evidence. */
  caption: string;
  /**
   * Licence and attribution line. Mandatory for any third-party or derived
   * image. Pass the full credit including a link to the licence.
   */
  credit?: string;
  /** Link to the unoptimised original, so detail can be judged exactly. */
  full?: string;
  widths?: number[];
}

const { src, alt, caption, credit, full, widths } = Astro.props;
const sizes = "(min-width: 1120px) 1040px, 100vw";
---

<figure>
  <Picture
    src={src}
    alt={alt}
    formats={["avif", "webp"]}
    widths={widths ?? [640, 960, 1280, 1920]}
    sizes={sizes}
    quality={82}
  />
  <figcaption>
    <span class="caption">{caption}</span>
    {credit && <span class="credit" set:html={credit} />}
    {
      full && (
        <a class="full" href={full} target="_blank" rel="noopener">
          View full resolution
        </a>
      )
    }
  </figcaption>
</figure>

<style>
  figure {
    margin: 0;
  }

  figure :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .credit {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .full {
    font-size: var(--text-xs);
    align-self: start;
  }
</style>
