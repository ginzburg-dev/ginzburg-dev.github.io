---
import StatusBadge from "./StatusBadge.astro";
import type { Status } from "./StatusBadge.astro";

interface Props {
  title: string;
  summary: string;
  years?: string;
  status: Status;
  stack?: string[];
  href?: string;
  repo?: string;
}

const { title, summary, years, status, stack, href, repo } = Astro.props;
---

<article class="card">
  <header>
    <h3>
      {href ? <a href={href}>{title}</a> : title}
    </h3>
    <p class="meta">
      {years && <span class="years">{years}</span>}
      <StatusBadge status={status} />
    </p>
  </header>

  <p class="summary">{summary}</p>

  {
    stack && stack.length > 0 && (
      <p class="stack">{stack.join(" · ")}</p>
    )
  }

  {
    repo && (
      <p class="links">
        <a href={repo} target="_blank" rel="noopener">
          Source
        </a>
      </p>
    )
  }
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  h3 {
    font-size: var(--text-lg);
    font-weight: 620;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .years {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .summary {
    font-size: var(--text-base);
    color: var(--ink-muted);
    max-width: 62ch;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .links {
    font-size: var(--text-sm);
  }
</style>
