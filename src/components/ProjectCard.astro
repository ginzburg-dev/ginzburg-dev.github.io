---
import StatusBadge from "./StatusBadge.astro";
import type { Status } from "./StatusBadge.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  summary: string;
  years?: string;
  status: Status;
  stack?: string[];
  href?: string;
  repo?: string;
  thumb?: ImageMetadata;
  thumbAlt?: string;
  credit?: string;
}

const { title, summary, years, status, stack, href, repo, thumb, thumbAlt, credit } = Astro.props;
---

<article class:list={["card", { "has-thumb": thumb }]}>
  {
    thumb && (
      <div class="thumb-col">
        <a class="thumb" href={href ?? repo}>
          <Image src={thumb} alt={thumbAlt ?? ""} widths={[320, 640]} sizes="(min-width: 40rem) 14rem, 100vw" quality={86} />
        </a>
        {credit && <p class="credit" set:html={credit} />}
      </div>
    )
  }
  <div class="body">
  <header>
    <h3>
      {href ? <a href={href}>{title}</a> : title}
    </h3>
    <p class="meta">
      {years && <span class="years">{years}</span>}
      <StatusBadge status={status} />
    </p>
  </header>

  <p class="summary">{summary}</p>

  {
    stack && stack.length > 0 && (
      <p class="stack">{stack.join(" · ")}</p>
    )
  }

  {
    repo && (
      <p class="links">
        <a href={repo} target="_blank" rel="noopener">
          Source
        </a>
      </p>
    )
  }
  </div>
</article>

<style>
  .card {
    padding-block: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .card.has-thumb {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .credit {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .card.has-thumb {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }

  h3 {
    font-size: var(--text-lg);
    font-weight: 620;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .years {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .summary {
    font-size: var(--text-base);
    color: var(--ink-muted);
    max-width: 62ch;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .links {
    font-size: var(--text-sm);
  }
</style>
