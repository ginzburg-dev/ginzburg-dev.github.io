---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { secondaryProjects } from "../../data/secondary";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const groups = [
  "Graphics & GPU Engineering",
  "Machine Learning & Inference",
  "Production Software & Backend",
] as const;

const grouped = groups.map((name) => ({
  name,
  entries: projects.filter((p) => p.data.areas[0] === name),
}));

const tools = secondaryProjects.filter((p) => p.group === "tools");
const platform = secondaryProjects.filter((p) => p.group === "platform");
---

<PageLayout
  title="Projects"
  heading="Projects"
  description="Engineering projects across computer graphics, GPU computing, machine learning and production software."
  lede="Denoisers, a rendering engine, inference runtimes and the production tools around them. Each project lists what is built and what is not."
  path="/projects/"
>
  <div class="wrap">
    {
      grouped.map((group) => (
        <section class="group">
          <h2>{group.name}</h2>
          <div class="cards">
            {group.entries.map((entry) => (
              <ProjectCard
                title={entry.data.title}
                summary={entry.data.summary}
                years={entry.data.years}
                status={entry.data.status}
                stack={entry.data.stack}
                href={`/projects/${entry.id}/`}
                repo={entry.data.repo}
              />
            ))}
          </div>
        </section>
      ))
    }

    <section class="group">
      <h2>Tools</h2>
      <p class="note">
        Smaller released tools, each with public source.
      </p>
      <ul class="list">
        {
          tools.map((item) => (
            <li>
              <div class="row">
                <span class="name">{item.title}</span>
                <StatusBadge status={item.status} />
                <span class="years">{item.years}</span>
              </div>
              <p class="summary">{item.summary}</p>
              <p class="meta">
                <span class="stack">{item.stack.join(" · ")}</span>
                {item.repo && (
                  <a href={item.repo} target="_blank" rel="noopener">
                    Source
                  </a>
                )}
                {item.video && (
                  <a href={item.video} target="_blank" rel="noopener">
                    Showreel
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="group">
      <h2>Platform and agent work</h2>
      <ul class="list">
        {
          platform.map((item) => (
            <li>
              <div class="row">
                <span class="name">{item.title}</span>
                <StatusBadge status={item.status} />
                <span class="years">{item.years}</span>
              </div>
              <p class="summary">{item.summary}</p>
              <p class="meta">
                <span class="stack">{item.stack.join(" · ")}</span>
                {item.repo && (
                  <a href={item.repo} target="_blank" rel="noopener">
                    Source
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</PageLayout>

<style>
  .group {
    padding-block: var(--space-6);
  }

  .group + .group {
    border-top: 1px solid var(--rule-strong);
  }

  h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .note {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }

  .cards {
    max-width: 78ch;
  }

  .list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    max-width: 78ch;
  }

  .list li {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .name {
    font-weight: 600;
  }

  .years,
  .stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .summary {
    font-size: var(--text-base);
    color: var(--ink-muted);
  }

  .meta {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    align-items: baseline;
    font-size: var(--text-sm);
  }
</style>
