---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import { secondaryProjects } from "../../data/secondary";
import tsThumb from "../../assets/projects/ts-thumb.jpg";
import ncThumb from "../../assets/projects/nc-smart-mask.jpg";
import r4dThumb from "../../assets/projects/r4d-train.jpg";
import gndThumb from "../../assets/projects/gnd-noise-to-clean.jpg";
import gdThumb from "../../assets/projects/gd-denoising-results-grid.jpg";
import dmxThumb from "../../assets/projects/dmx-room-comparison.jpg";

/** Card pictures, the same as on the home page, with their credits. */
const thumbs: Record<string, { src: ImageMetadata; alt: string; credit?: string }> = {
  "neural-composer": { src: ncThumb, alt: "Neural Composer with a SAM 2.1 roto mask over an actor in the viewer.", credit: "<i>Tears of Steel</i> (2012), Blender Foundation / Blender Institute, CC BY 3.0" },
  radiance4d: { src: r4dThumb, alt: "A locomotive on a rail yard rendered from Gaussian splats.", credit: "Splats: INRIA 3DGS <i>train</i> (Tanks and Temples), rendered in Radiance4D" },
  "ginzburg-neural-denoiser": { src: gndThumb, alt: "A furred animal head, noisy render on the left, denoised on the right.", credit: "Image by Joanna Kobierska" },
  "ginzburg-denoiser": { src: gdThumb, alt: "Before-and-after denoising comparisons of material, fur and hair." },
  "denoise-machine-x": { src: dmxThumb, alt: "A room render before and after denoising." },
};

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const groups = [
  "Graphics & GPU Engineering",
  "Machine Learning & Inference",
  "Production Software & Backend",
] as const;

const grouped = groups.map((name) => ({
  name,
  entries: projects.filter((p) => p.data.areas[0] === name),
}));

const tools = secondaryProjects.filter((p) => p.group === "tools");
const platform = secondaryProjects.filter((p) => p.group === "platform");
---

<PageLayout
  title="Projects"
  heading="Projects"
  description="Engineering projects across computer graphics, GPU computing, machine learning and production software."
  lede="Denoisers, a rendering engine, inference runtimes and the production tools around them. Each project lists what is built and what is not."
  path="/projects/"
>
  <div class="wrap">
    <section class="group">
      <h2>AI Film Making</h2>
      <div class="cards">
        <ProjectCard
          title="AI Film Studio"
          summary="A complete AI film studio, from script to final cut, with an agent harness over MCP and 3D reconstruction from Gaussian splats."
          years="2026–present"
          status="production"
          stack={["TypeScript", "Next.js", "Three.js", "Python", "FastAPI", "ComfyUI", "MCP"]}
          href="/ai-film-studio/"
          thumb={tsThumb}
          thumbAlt="The app's editor with a frame of Wilson the kitten leaning over a river, above a timeline."
        />
      </div>
    </section>

    {
      grouped.map((group) => (
        <section class="group">
          <h2>{group.name}</h2>
          <div class="cards">
            {group.entries.map((entry) => (
              <ProjectCard
                title={entry.data.title}
                summary={entry.data.summary}
                years={entry.data.years}
                status={entry.data.status}
                stack={entry.data.stack}
                href={`/projects/${entry.id}/`}
                repo={entry.data.repo}
                thumb={thumbs[entry.id]?.src}
                thumbAlt={thumbs[entry.id]?.alt}
                credit={thumbs[entry.id]?.credit}
              />
            ))}
          </div>
        </section>
      ))
    }

    <section class="group">
      <h2>Tools</h2>
      <p class="note">
        Smaller released tools, each with public source.
      </p>
      <ul class="list">
        {
          tools.map((item) => (
            <li>
              <div class="row">
                <span class="name">{item.title}</span>
                <StatusBadge status={item.status} />
                <span class="years">{item.years}</span>
              </div>
              <p class="summary">{item.summary}</p>
              <p class="meta">
                <span class="stack">{item.stack.join(" · ")}</span>
                {item.repo && (
                  <a href={item.repo} target="_blank" rel="noopener">
                    Source
                  </a>
                )}
                {item.video && (
                  <a href={item.video} target="_blank" rel="noopener">
                    Showreel
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="group">
      <h2>Platform and agent work</h2>
      <ul class="list">
        {
          platform.map((item) => (
            <li>
              <div class="row">
                <span class="name">{item.title}</span>
                <StatusBadge status={item.status} />
                <span class="years">{item.years}</span>
              </div>
              <p class="summary">{item.summary}</p>
              <p class="meta">
                <span class="stack">{item.stack.join(" · ")}</span>
                {item.repo && (
                  <a href={item.repo} target="_blank" rel="noopener">
                    Source
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</PageLayout>

<style>
  .group {
    padding-block: var(--space-6);
  }

  .group + .group {
    border-top: 1px solid var(--rule-strong);
  }

  h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-2);
  }

  .note {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }

  .cards {
    max-width: 78ch;
  }

  .list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    max-width: 78ch;
  }

  .list li {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .name {
    font-weight: 600;
  }

  .years,
  .stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .summary {
    font-size: var(--text-base);
    color: var(--ink-muted);
  }

  .meta {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    align-items: baseline;
    font-size: var(--text-sm);
  }
</style>
