---
import BaseLayout from "../layouts/BaseLayout.astro";
import Figure from "../components/Figure.astro";
import Gallery from "../components/Gallery.astro";

import cutShot from "../assets/projects/ts-sequence.jpg";
import boardShot from "../assets/projects/ts-storyboard.jpg";
import setShot from "../assets/projects/ts-3d-set.jpg";
import libraryShot from "../assets/projects/ts-library.jpg";
import characterShot from "../assets/projects/ts-library-character.jpg";
import painterShot from "../assets/projects/ts-painter.jpg";

const stack = [
  "TypeScript", "Next.js / React", "Three.js", "Python", "FastAPI", "SQLite",
  "ComfyUI", "RunPod", "MapAnything", "Open3D", "SAM 3", "Stable Diffusion",
  "LTX-2.5", "MiniMax H3", "Wan 2.2", "ElevenLabs", "MCP",
];

const pipeline = [
  ["Script", "Written and revised with a chat model, versioned, approved, then published into a shot list."],
  ["Board", "Every shot with its action, camera, length and cast. Sketches, keyframes and takes, each approved on its own."],
  ["Library", "Characters, places, props and style. The approved picture is canon and goes into every frame that needs it."],
  ["3D", "The place built from pictures and video, with cameras and stand-ins per shot. New angles are drawn from it."],
  ["Takes", "Video from the approved frame on GPU workflows or video APIs, queued, priced and judged."],
  ["Sound", "Voices from the Library, music by sections, effects, laid on their own tracks."],
  ["Cut", "A versioned Working Cut: trims to the frame, dissolves, masks, colour at a cut, export."],
];

const agentFlow = [
  ["Request", "What you asked, in your words. The agent restates it as a task: goal, targets, kinds of work, when it is done."],
  ["Gate", "Code checks every changing call against that task. Wrong shot, wrong kind of work or no approved input: refused before it runs."],
  ["Tools", "115 tools over the same HTTP API the windows use: board, Library, pictures, takes, the cut, 3D, sound, the docs."],
  ["Controller", "Tries per shot, a budget per task, a stop when it goes round in circles. Paid runs wait in a queue for you."],
  ["Review", "A second model reads the calls and the answer against “done when” and sends back what is missing."],
  ["You", "Approvals stay yours. Every change the agent makes in place has an undo, and each Auto task starts from a snapshot."],
];

// Agent bench. Same task, same model: the first run against the last run after the harness changes.
// Source: scripts/agent_bench (results.jsonl, 627 runs), tasks with a valid run before and after.
const bench = [
  { model: "Gemma 4 26B A4B", kind: "open", n: 6, before: 0.13, after: 0.75 },
  { model: "Gemma 4 31B", kind: "open", n: 8, before: 0.42, after: 0.76 },
  { model: "gpt-oss-20b", kind: "open", n: 3, before: 0.38, after: 0.61 },
  { model: "Qwen3.5 9B on the laptop", kind: "local", n: 3, before: 0.29, after: 0.42 },
  { model: "Qwen3.6 35B A3B", kind: "open", n: 8, before: 0.62, after: 0.73 },
  { model: "Qwen3.8 27B", kind: "open", n: 4, before: 0.57, after: 0.65 },
  { model: "Qwen4 Max", kind: "cloud", n: 4, before: 0.65, after: 0.97 },
  { model: "GPT-6 Luna", kind: "cloud", n: 4, before: 0.62, after: 0.88 },
];

const latest = [
  { model: "GPT-6.1 Terra", tasks: 18, score: 0.86, usd: 0.262 },
  { model: "DeepSeek V4.1 Flash", tasks: 16, score: 0.83, usd: 0.042 },
  { model: "Qwen3.8 27B (open)", tasks: 36, score: 0.81, usd: 0.092 },
  { model: "Qwen4 Max", tasks: 14, score: 0.79, usd: 0.326 },
  { model: "GPT-6 Luna", tasks: 32, score: 0.76, usd: 0.081 },
  { model: "Gemma 4 31B (open)", tasks: 30, score: 0.73, usd: 0.082 },
  { model: "Qwen3.6 35B A3B (open)", tasks: 21, score: 0.73, usd: 0.042 },
  { model: "gpt-oss-20b (open)", tasks: 18, score: 0.44, usd: 0.022 },
];

const pct = (v: number) => `${Math.round(v * 100)}%`;
---

<BaseLayout
  title="AI Film Studio"
  description="An AI film studio in one app. Script, storyboard, characters, 3D staging, video takes, sound and the edit, with an agent that works through the same tools as the artist."
  path="/ai-film-studio/"
>
  <article class="ts">
    <header class="wrap head">
      <p class="eyebrow">Own project</p>
      <h1>AI Film Studio</h1>
      <p class="lede">
        One app that takes an animated episode from the script to the finished cut: storyboard, characters,
        3D staging, video takes, sound and the edit, with an agent that works through the same tools as the
        artist.
      </p>

      <dl class="facts">
        <div><dt>App</dt><dd>Turbo Sandwich</dd></div>
        <div><dt>Years</dt><dd>2026 – present</dd></div>
        <div><dt>Role</dt><dd>Sole author</dd></div>
        <div><dt>Status</dt><dd>In daily production use</dd></div>
        <div><dt>In use on</dt><dd>“Wilson's Little World”, an animated series</dd></div>
        <div class="stack-cell"><dt>Stack</dt><dd class="stack">{stack.join(" · ")}</dd></div>
      </dl>
    </header>

    <div class="wrap">
      <Figure
        src={cutShot}
        alt="The Sequence editor with episode 1 of Wilson's Little World: the take browser on the left, the player showing Plop the frog, and a timeline with 100 picture clips over five audio tracks for clip sound, dialogue, music, ambience and effects."
        caption="The Working Cut of episode 1: 100 clips, 5 min 5 s, with dialogue, music, ambience and effects on their own tracks. Every clip knows the shot, the take and the picture it came from."
        full="/figures/turbo-sandwich/ts-sequence.jpg"
      />
    </div>

    <section class="wrap section">
      <div class="intro">
        <h2>One app for the whole episode</h2>
        <p>
          AI video tools make clips. A film needs more than clips: the same characters in every shot, a place that
          holds together when the camera turns, cuts that respect screen direction, and a record of what was made
          from what. The app keeps all of that in one project. A shot carries its script line, its approved
          frame, its takes and its place in the cut, so a change anywhere can be traced and redone.
        </p>
        <p>
          It runs on your own keys. Pictures come from GPT Image, video from GPU workflows on RunPod or a local
          ComfyUI (LTX-2.5, MiniMax H3, Wan 2.2) and from video APIs (Kling, Seedance, Hailuo), sound from
          ElevenLabs. The app finds GPU machines, starts and prepares them, and releases them inside the spending
          limit you set.
        </p>
      </div>

      <ol class="pipeline" aria-label="From script to cut">
        {pipeline.map(([name, text], i) => (
          <li>
            <span class="step">{String(i + 1).padStart(2, "0")}</span>
            <h3>{name}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap section">
      <div class="split">
        <div class="copy">
          <h2>Board and storyboard</h2>
          <p>
            The published script becomes a shot list. The Board shows each shot with its picture, length, stage
            and takes; the storyboard view lays the frames out as a wall to read the scene at a glance.
          </p>
          <p>
            A frame is checked against its neighbours before any video is made: screen direction, eyelines, shot
            size, which paw holds the prop. A defect is fixed in the picture, where it costs cents, not in the take.
          </p>
        </div>
      </div>
      <Figure
        src={boardShot}
        alt="The storyboard view of the Board: twelve keyframes of episode 1 in a grid, each with its shot code, length, approval state and a line of action."
        caption="Episode 1 on the storyboard wall: 113 shots, each frame approved on its own before animation."
        full="/figures/turbo-sandwich/ts-storyboard.jpg"
      />
    </section>

    <section class="wrap section">
      <div class="split">
        <div class="copy">
          <h2>Characters stay the same</h2>
          <p>
            The Library holds the cast, places, props and style. Each item keeps its versions, and the approved
            one is canon: every new frame gets it as a reference, together with a lineup for relative heights. Words
            point to the approved picture instead of describing the character again.
          </p>
        </div>
      </div>
      <Gallery
        items={[
          { src: libraryShot, alt: "The Asset Library grid: twelve characters, lineups and master shots of Gold River." },
          { src: characterShot, alt: "Wilson the kitten open in the Library, with his 13 versions, the approved final look and the references used to draw it." },
        ]}
        caption="Left: the cast, lineups and master shots of the series. Right: one character with its versions, the approved look and what it was made from."
      />
    </section>

    <section class="wrap section">
      <div class="split">
        <div class="copy">
          <h2>Places in 3D</h2>
          <p>
            A new camera angle is where AI pictures usually fall apart. So each place is built in 3D. A take or a
            set of pictures goes through MapAnything on the local GPU, which gives every frame its camera and depth
            at one scale; the depths are fused into a mesh, and the approved pictures are projected back onto it.
            The result is a textured set, not a point cloud.
          </p>
          <p>
            Each shot gets a camera and stand-ins for the cast in this set. The render of that camera gives the
            layout, and the nearest approved picture gives the look; the image model draws the new frame from both.
          </p>
        </div>
      </div>
      <Figure
        src={setShot}
        alt="The 3D tab looking through the camera river_to_oak: a reconstructed woodland river bank with mossy stones, ferns and a sunlit path between trees, the camera's lens and position on the right."
        caption="The Gold River set seen through one of its shot cameras. The bank, stones and woods come from the reconstruction, textured with the approved pictures."
        full="/figures/turbo-sandwich/ts-3d-set.jpg"
      />

      <figure class="pairs">
        <div class="pair">
          <div class="clip">
            <span class="tag">3D layout</span>
            <video src="/figures/turbo-sandwich/walk-3d.mp4" poster="/figures/turbo-sandwich/walk-3d.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="A rough 3D blockout: two capsule stand-ins walk along a path between tree trunks, the camera following."></video>
          </div>
          <div class="clip">
            <span class="tag">Video model</span>
            <video src="/figures/turbo-sandwich/walk-take.mp4" poster="/figures/turbo-sandwich/walk-take.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="The same move drawn by MiniMax H3: the kitten and the rabbit walk along a forest path beside a river."></video>
          </div>
        </div>
        <div class="pair">
          <div class="clip">
            <span class="tag">3D layout</span>
            <video src="/figures/turbo-sandwich/orbit-3d.mp4" poster="/figures/turbo-sandwich/orbit-3d.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="A 3D blockout: the camera orbits 180 degrees around two stand-ins on a clearing."></video>
          </div>
          <div class="clip">
            <span class="tag">Video model</span>
            <video src="/figures/turbo-sandwich/orbit-take.mp4" poster="/figures/turbo-sandwich/orbit-take.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="The same orbit drawn by MiniMax H3: the camera goes round the kitten and the rabbit, who keep their places."></video>
          </div>
        </div>
        <figcaption>
          A camera move blocked in 3D and the take a video model drew from it (MiniMax H3, guided by the 3D render
          and the approved pictures). The move, the order of the characters and the side of the place follow the
          layout, including a 180° orbit.
        </figcaption>
      </figure>
    </section>

    <section class="wrap section">
      <div class="split">
        <div class="copy">
          <h2>Takes, queue and GPUs</h2>
          <p>
            A take starts from the approved frame. The ComfyUI workflows are stored as fixed reference graphs with
            declared inputs, so a run is patched and checked, never edited by hand. Every run is priced before it
            starts and joins one queue with the picture and sound jobs.
          </p>
          <p>
            GPU pods form one pool for every project on the machine. A project borrows a warm pod while it has work
            and hands it back, an agent inside each pod is reached only through an authenticated gateway, and a
            dead-man switch stops pods the app no longer knows about. API keys never leave the backend.
          </p>
        </div>
      </div>
    </section>

    <section class="wrap section">
      <div class="split">
        <div class="copy">
          <h2>Painter</h2>
          <p>
            A layered paint editor inside the app, for the fixes a frame needs before it is animated: move, clone,
            masks, crop, colour, AI upscale and Generative Fill on a painted area. Redraw and Neural Painter live run
            a local model on this computer's GPU and redraw the picture as you paint, about one frame a second, from a
            pencil sketch, over a painting or over a photo.
          </p>
        </div>
      </div>
      <Figure
        src={painterShot}
        alt="The Painter with a frame of Wilson the kitten holding a magnifying glass by the river: tools and layers on the left, the Redraw panel with Neural Painter live on the right."
        caption="The Painter on a frame of the series, with the Redraw panel and Neural Painter live on the right."
        full="/figures/turbo-sandwich/ts-painter.jpg"
      />
    </section>

    <section class="wrap section">
      <div class="split">
        <div class="copy">
          <h2>The Working Cut</h2>
          <p>
            The editor is built for cutting generated takes. Trims are frame-aligned to the take's own frames, and a
            clip can be swapped for another take of the same shot without moving its neighbours. A clip can be laid
            over another with a painted mask, matched in colour to its neighbour at the cut, or trimmed to where the
            motion starts, so a cut never opens on a still first frame.
          </p>
          <p>
            Each saved version is kept. The player reads the next 12 seconds of files ahead and plays across clips
            and dissolves. The cut exports as an MP4, with upscaled takes, or as FCP7 XML for Premiere and Resolve.
            A review script renders every cut as a sheet of frames, so screen direction, repeated setups and jumps
            are checked like an editor would.
          </p>
        </div>
      </div>
    </section>

    <section class="wrap section">
      <div class="split">
        <div class="copy">
          <h2>An agent that works in the app</h2>
          <p>
            The in-app assistant is one agent with tools. It does the same work a person does in the windows,
            through the same requests: it stages a 3D set, draws a frame, starts a take, waits for it, looks at the
            result and tries again. The same tools are open to Claude Code, Codex and Cursor over an MCP server.
          </p>
          <p>
            A model on its own is not enough to trust with a production. The harness around it decides what it may
            touch and when it has to stop:
          </p>
        </div>
      </div>

      <figure class="flow-fig">
        <ol class="flow" aria-label="How the agent harness handles a task">
          {agentFlow.map(([name, text]) => (
            <li><h3>{name}</h3><p>{text}</p></li>
          ))}
        </ol>
        <figcaption>
          The harness. The model plans and calls tools; code holds the task, checks every change against it and
          keeps the decisions that matter with the person.
        </figcaption>
      </figure>
    </section>

    <section class="wrap section">
      <div class="split">
        <div class="copy">
          <h2>Which model can drive it: a bench on a real series</h2>
          <p>
            To find out which models can run a production and what it costs, I built a bench on a copy of the
            series' real project: 105 shots, 162 takes, a 49-clip cut with sound, 3D sets and reconstructions. The
            tasks are what I do every day: move a clip by half a second, place a line after another, write a dialogue
            prompt, judge ten takes, find the worst cuts, remove a tree from a 3D set without touching the woods,
            redraw a frame from a new angle. Facts are checked by code; taste by one fixed judge model with a written
            rubric. Paid media and GPUs are off.
          </p>
          <p>
            627 runs over 18 models, from GPT-6 to open models on OpenRouter and Qwen on the laptop. The first runs
            were expensive for the wrong reason: one 3D task cost $2.09, and 64% of it was the growing history being
            written to the cache, from 21k to 200k tokens. Trimming old tool results and caching the stable part cut a
            step on Qwen4 Max from $0.0086 to $0.00055.
          </p>
          <p>
            When every model failed a task the same way, I fixed the tool or the task, not the prompt: composite tools
            for one flat edit, a shot brief with the exact line and the rules that name the shot, a review pass. Seven
            tasks were held out and never used for tuning.
          </p>
        </div>
      </div>

      <figure class="chart-fig">
        <div class="chart" role="img" aria-label="Score per model on the same tasks, first run against the run after the harness changes. Across 45 reruns on 12 models the mean rose from 44% to 73%.">
          <div class="legend" aria-hidden="true">
            <span><i class="dot before"></i>First run</span>
            <span><i class="dot after"></i>After the harness changes</span>
          </div>
          <ul class="rows">
            {bench.map((b) => (
              <li title={`${b.model}: ${pct(b.before)} → ${pct(b.after)} over ${b.n} tasks`}>
                <span class="name">{b.model}<small>{b.n} tasks</small></span>
                <span class="track">
                  <span class="bar" style={`left:${b.before * 100}%;width:${(b.after - b.before) * 100}%`}></span>
                  <i class="dot before" style={`left:${b.before * 100}%`}></i>
                  <i class="dot after" style={`left:${b.after * 100}%`}></i>
                </span>
                <span class="vals"><span class="v-before">{pct(b.before)}</span> → <strong>{pct(b.after)}</strong></span>
              </li>
            ))}
          </ul>
          <div class="axis" aria-hidden="true"><span>0%</span><span>50%</span><span>100%</span></div>
        </div>
        <figcaption>
          Same model, same task: the first run against the last run after the harness changes. Across all 45 reruns
          on 12 models the mean score rose from 44% to 73%. The weakest models gained the most.
        </figcaption>
      </figure>

      <figure class="table-fig">
        <table>
          <caption>Where the models ended up (last run of each task)</caption>
          <thead>
            <tr><th scope="col">Model</th><th scope="col">Tasks</th><th scope="col">Mean score</th><th scope="col">Cost per task</th></tr>
          </thead>
          <tbody>
            {latest.map((r) => (
              <tr>
                <th scope="row">{r.model}</th>
                <td>{r.tasks}</td>
                <td>{pct(r.score)}</td>
                <td>${r.usd.toFixed(3)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <figcaption>
          A cheap cloud model and an open 27B model come within a few points of the strongest model at a third to a
          sixth of the cost. Judging takes by eye and drawing a reverse angle stay weak for every model; those stay
          with the artist.
        </figcaption>
      </figure>
    </section>

    <section class="wrap section">
      <div class="split">
        <div class="copy">
          <h2>How it is built</h2>
        </div>
      </div>
      <div class="arch" role="img" aria-label="Architecture: the web console, the CLI, the in-app agent and outside AI apps over MCP all call one FastAPI backend, which runs the scheduler, queue and budgets and talks to local models, the RunPod GPU pool and the media APIs.">
        <div class="tier">
          <span class="tier-name">Clients</span>
          <div class="boxes">
            <span>Web console<small>Next.js, React, Three.js</small></span>
            <span>In-app agent<small>runs on the server</small></span>
            <span>ts CLI</span>
            <span>Claude, Codex, Cursor<small>over MCP</small></span>
          </div>
        </div>
        <div class="tier">
          <span class="tier-name">Backend</span>
          <div class="boxes">
            <span class="wide">FastAPI, about 270 HTTP requests<small>scheduler and worker pool, one queue, budget manager, a SQLite database per project, restart-safe</small></span>
          </div>
        </div>
        <div class="tier">
          <span class="tier-name">Compute</span>
          <div class="boxes">
            <span>Local GPU<small>ComfyUI, MapAnything, SAM 3, Stable Diffusion, voices</small></span>
            <span>RunPod pool<small>gateway in each pod, ComfyUI on 127.0.0.1</small></span>
            <span>Media APIs<small>GPT Image, Kling, Seedance, Hailuo, ElevenLabs</small></span>
          </div>
        </div>
      </div>
      <ul class="notes">
        <li>The browser talks only to the backend. RunPod, Hugging Face and media keys never reach it or a pod.</li>
        <li>Video workflows are immutable reference graphs with declared bindings; a run is a verified patch of one.</li>
        <li>Several copies run on one machine, each with its own port and database; a second seat works over the LAN.</li>
        <li>The docs are the assistant's knowledge base: it reads them from disk on every question.</li>
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-7) var(--space-6);
    display: grid;
    gap: var(--space-4);
  }

  .lede {
    max-width: 62ch;
  }

  .facts {
    display: grid;
    gap: var(--space-4) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(9rem, max-content));
    margin: 0;
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--space-1);
  }

  dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .stack-cell {
    grid-column: 1 / -1;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .section {
    padding-top: var(--space-8);
    display: grid;
    gap: var(--space-5);
  }

  .section > *,
  .chart-fig > *,
  .table-fig > * {
    min-width: 0;
  }

  .ts > :last-child {
    padding-bottom: var(--space-8);
  }

  .intro,
  .copy {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-4);
  }

  .copy p,
  .intro p {
    color: var(--ink-muted);
  }

  /* pipeline */
  .pipeline {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-3);
  }

  .pipeline li,
  .flow li {
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    padding: var(--space-4);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .step {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .pipeline h3,
  .flow h3 {
    font-size: var(--text-base);
  }

  .pipeline p,
  .flow p {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* 3D pairs */
  .pairs {
    margin: var(--space-3) 0 0;
    display: grid;
    gap: var(--space-3);
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .clip {
    position: relative;
  }

  .clip video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-sunken);
  }

  .tag {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius);
  }

  figcaption,
  caption {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .pairs figcaption,
  .flow-fig figcaption,
  .chart-fig figcaption,
  .table-fig figcaption {
    margin-top: var(--space-1);
    max-width: var(--measure);
  }

  /* agent flow */
  .flow-fig,
  .chart-fig,
  .table-fig {
    margin: var(--space-3) 0 0;
    display: grid;
    gap: var(--space-3);
