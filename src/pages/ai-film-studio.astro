---
import BaseLayout from "../layouts/BaseLayout.astro";
import Figure from "../components/Figure.astro";
import Gallery from "../components/Gallery.astro";

import cutShot from "../assets/projects/ts-sequence.jpg";
import boardShot from "../assets/projects/ts-storyboard.jpg";
import setShot from "../assets/projects/ts-3d-set.jpg";
import libraryShot from "../assets/projects/ts-library.jpg";
import characterShot from "../assets/projects/ts-library-character.jpg";
import painterShot from "../assets/projects/ts-painter.jpg";

const stack = [
  "TypeScript", "Next.js / React", "Three.js", "Python", "FastAPI", "SQLite",
  "ComfyUI", "RunPod", "MapAnything", "Open3D", "SAM 3", "Stable Diffusion",
  "LTX-2.5", "MiniMax H3", "Wan 2.2", "ElevenLabs", "MCP",
];

const pipeline = [
  ["Script", "Written and revised with an LLM, then broken down into shots."],
  ["Storyboard", "Action, camera, duration and a final frame per shot."],
  ["Characters", "Approved once, referenced in every shot."],
  ["3D", "Every location built as a set, with a camera per shot."],
  ["Video", "Image-to-video on cloud GPUs or video APIs. Cost shown up front, every take versioned."],
  ["Sound", "Voices, score and effects on separate tracks."],
  ["Edit", "Assembly, conform and export."],
];

const agentFlow = [
  ["Task", "Each request becomes a written task with a clear finish line."],
  ["Check", "Every change is checked against the task."],
  ["Tools", "115 tools covering the full pipeline."],
  ["Limits", "Caps on retries and spend. Stuck loops are stopped."],
  ["Review", "A second model checks the result."],
  ["Sign-off", "The artist approves every frame and shot."],
];

// Agent bench: same task, same model, first run against the run after the changes to the assistant's tools and checks.
// Source: scripts/agent_bench (results.jsonl, 627 runs); tasks with a valid run before and after.
const bench = [
  { model: "Gemma 4 26B", n: 6, before: 0.13, after: 0.75 },
  { model: "Gemma 4 31B", n: 8, before: 0.42, after: 0.76 },
  { model: "gpt-oss-20b", n: 3, before: 0.38, after: 0.61 },
  { model: "Qwen3.5 9B, on a laptop", n: 3, before: 0.29, after: 0.42 },
  { model: "Qwen3.6 35B", n: 8, before: 0.62, after: 0.73 },
  { model: "Qwen3.8 27B", n: 4, before: 0.57, after: 0.65 },
  { model: "Qwen4 Max", n: 4, before: 0.65, after: 0.97 },
  { model: "GPT-6 Luna", n: 4, before: 0.62, after: 0.88 },
];

const latest = [
  { model: "GPT-6.1 Terra", tasks: 18, score: 0.86, usd: 0.262 },
  { model: "DeepSeek V4.1 Flash", tasks: 16, score: 0.83, usd: 0.042 },
  { model: "Qwen3.8 27B (open)", tasks: 36, score: 0.81, usd: 0.092 },
  { model: "Qwen4 Max", tasks: 14, score: 0.79, usd: 0.326 },
  { model: "GPT-6 Luna", tasks: 32, score: 0.76, usd: 0.081 },
  { model: "Gemma 4 31B (open)", tasks: 30, score: 0.73, usd: 0.082 },
  { model: "Qwen3.6 35B (open)", tasks: 21, score: 0.73, usd: 0.042 },
  { model: "gpt-oss-20b (open)", tasks: 18, score: 0.44, usd: 0.022 },
];

const pct = (v: number) => `${Math.round(v * 100)}%`;
---

<BaseLayout
  title="AI Film Studio"
  description="A complete AI film studio, from script to final cut, with an agent harness over MCP and 3D reconstruction from Gaussian splats."
  path="/ai-film-studio/"
>
  <article class="ts">
    <header class="wrap head">
      <p class="eyebrow">Own project</p>
      <h1>AI Film Studio</h1>
      <p class="lede">
        A complete AI film studio, from script to final cut. The first episode of an animated series was made
        entirely in it.
      </p>
      <p class="lede">
        An agent harness over MCP that makes even small open models reliable on real production tasks, at a
        fraction of the token cost.
      </p>
      <p class="lede">
        A complete 3D scene reconstruction system: each location is trained into a 3D scene from a few frames
        and shot from any new angle, consistent across the cut.
      </p>
    </header>

    <div class="wrap">
      <figure class="reel">
        <video src="/figures/turbo-sandwich/reel.mp4" poster="/figures/turbo-sandwich/reel.jpg"
          autoplay muted loop playsinline preload="auto"
          aria-label="Shots from episode 1 of Wilson's Little World: a forest river, Plop the frog on his rock, Wilson the kitten, Hollis the rabbit, the two friends crossing the water."></video>
        <figcaption>
          Episode 1 of “Wilson's Little World”, an animated series made entirely in the app.
        </figcaption>
      </figure>

      <dl class="facts">
        <div><dt>App</dt><dd>Turbo Sandwich</dd></div>
        <div><dt>Role</dt><dd>Creator and lead engineer</dd></div>
        <div><dt>Years</dt><dd>2026 – present</dd></div>
        <div><dt>Status</dt><dd>In daily use</dd></div>
        <div><dt>First film</dt><dd>“Wilson's Little World”, episode 1</dd></div>
        <div class="stack-cell"><dt>Stack</dt><dd class="stack">{stack.join(" · ")}</dd></div>
      </dl>
    </div>

    <section class="wrap section">
      <div class="copy">
        <h2>3D previs to final shot</h2>
        <p>
          The camera move is set up in 3D with simple stand-ins. A video model then renders the real shot from it, with the approved characters and set.
        </p>
      </div>
      <figure class="pairs">
        <div class="pair">
          <div class="clip">
            <span class="tag">3D previs</span>
            <video src="/figures/turbo-sandwich/orbit-3d.mp4" poster="/figures/turbo-sandwich/orbit-3d.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="A simple 3D layout: the camera goes half way round two figures standing on a forest path."></video>
          </div>
          <div class="clip">
            <span class="tag">Final shot</span>
            <video src="/figures/turbo-sandwich/orbit-take.mp4" poster="/figures/turbo-sandwich/orbit-take.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="The same move drawn by MiniMax H3: the camera goes round the kitten and the rabbit and ends on the river behind them."></video>
          </div>
        </div>
        <div class="pair">
          <div class="clip">
            <span class="tag">3D previs</span>
            <video src="/figures/turbo-sandwich/walk-3d.mp4" poster="/figures/turbo-sandwich/walk-3d.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="A simple 3D layout: two figures walk along a path between trees, the camera following behind."></video>
          </div>
          <div class="clip">
            <span class="tag">Final shot</span>
            <video src="/figures/turbo-sandwich/walk-take.mp4" poster="/figures/turbo-sandwich/walk-take.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="The same move drawn by MiniMax H3: the kitten and the rabbit walk along a forest path beside a river."></video>
          </div>
        </div>
        <figcaption>Left: 3D previs. Right: final shot, MiniMax H3.</figcaption>
      </figure>
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Editorial</h2>
        <p>
          A video editor built for AI footage: swap takes, layer shots with masks, add voices, music and effects, export to Premiere or DaVinci Resolve.
        </p>
      </div>
      <Figure
        src={cutShot}
        alt="The editor with episode 1: video versions on the left, the player with Plop the frog in the middle, and a timeline with 100 clips over tracks for dialogue, music, background sound and effects."
        caption="Episode 1 timeline: 100 clips with dialogue, music, ambience and effects."
        full="/figures/turbo-sandwich/ts-sequence.jpg"
      />
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>One pipeline</h2>
      </div>

      <ol class="pipeline" aria-label="The steps of making an episode">
        {pipeline.map(([name, text], i) => (
          <li>
            <span class="step">{String(i + 1).padStart(2, "0")}</span>
            <h3>{name}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Storyboard</h2>
      </div>
      <Figure
        src={boardShot}
        alt="The storyboard: twelve finished frames of episode 1 in a grid, each with its shot number, length, approval and a line of action."
        caption="Episode 1: 113 shots, each frame approved before animation."
        full="/figures/turbo-sandwich/ts-storyboard.jpg"
      />
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Character consistency</h2>
      </div>
      <Gallery
        items={[
          { src: libraryShot, alt: "The library of the series: the characters, two lineups and the location sketches." },
          { src: characterShot, alt: "Wilson the kitten in the library, with his 13 versions, the approved look and the pictures used to draw it." },
        ]}
        caption="Series library and a character sheet with every version."
      />
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Set reconstruction</h2>
        <p>
          Each location is rebuilt in 3D as Gaussian splats from its frames (MapAnything, gsplat). World Labs Atlas fills in what no frame shows. Every shot gets its own camera on that set.
        </p>
      </div>
      <Figure
        src={setShot}
        alt="The 3D view through one of the shot cameras: a forest river bank with mossy stones, ferns and a sunlit path between the trees, with the camera's settings on the right."
        caption="The Gold River set, seen through a shot camera."
        full="/figures/turbo-sandwich/ts-3d-set.jpg"
      />
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Paint and cleanup</h2>
        <p>
          Paint, mask and add new elements to any frame, like in Photoshop, without leaving the app. Neural
          Painter redraws the frame live as you paint.
        </p>
      </div>
      <Figure
        src={painterShot}
        alt="The paint editor with a frame of Wilson the kitten holding a magnifying glass by the river: tools and layers on the left, the Neural Painter panel on the right."
        caption="Paint editor on a frame from the series."
        full="/figures/turbo-sandwich/ts-painter.jpg"
      />
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Agent harness</h2>
        <p>
          AI agents build sets, draw frames, make video, check the result and try again. They also work from Claude Code, Codex and Cursor through MCP. Rules in code keep them on task:
        </p>
      </div>

      <figure class="flow-fig">
        <ol class="flow" aria-label="How the app keeps the assistant on task">
          {agentFlow.map(([name, text]) => (
            <li><h3>{name}</h3><p>{text}</p></li>
          ))}
        </ol>
        <figcaption>The model does the work. The harness keeps it on task.</figcaption>
      </figure>
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Model benchmark</h2>
        <p>
          18 AI models, 627 test runs on real production tasks. The harness raised scores across the board and cut token cost per step up to 15 times.
        </p>
      </div>

      <figure class="chart-fig">
        <div class="chart" role="img" aria-label="Score of each model on the same tasks: the first run, and the run after the changes to the app. Over 45 repeated runs on 12 models, the average went from 44% to 73%.">
          <div class="legend" aria-hidden="true">
            <span><i class="dot before"></i>Baseline</span>
            <span><i class="dot after"></i>With the harness</span>
          </div>
          <ul class="rows">
            {bench.map((b) => (
              <li title={`${b.model}: ${pct(b.before)} → ${pct(b.after)} over ${b.n} tasks`}>
                <span class="name">{b.model}<small>{b.n} tasks</small></span>
                <span class="track">
                  <span class="bar" style={`left:${b.before * 100}%;width:${(b.after - b.before) * 100}%`}></span>
                  <i class="dot before" style={`left:${b.before * 100}%`}></i>
                  <i class="dot after" style={`left:${b.after * 100}%`}></i>
                </span>
                <span class="vals"><span class="v-before">{pct(b.before)}</span> → <strong>{pct(b.after)}</strong></span>
              </li>
            ))}
          </ul>
          <div class="axis" aria-hidden="true"><span>0%</span><span>50%</span><span>100%</span></div>
        </div>
        <figcaption>
          Same model, same tasks. Average score 44% → 73%, with the largest gains on the smallest models.
        </figcaption>
      </figure>

      <figure class="table-fig">
        <table>
          <caption>Final results (latest run of each task)</caption>
          <thead>
            <tr><th scope="col">Model</th><th scope="col">Tasks</th><th scope="col">Score</th><th scope="col">Cost per task</th></tr>
          </thead>
          <tbody>
            {latest.map((r) => (
              <tr>
                <th scope="row">{r.model}</th>
                <td>{r.tasks}</td>
                <td>{pct(r.score)}</td>
                <td>${r.usd.toFixed(3)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <figcaption>
          Open and low-cost models land within a few points of the leader at a third to a sixth of the cost.
        </figcaption>
      </figure>
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Architecture</h2>
      </div>
      <div class="arch" role="img" aria-label="Architecture: web app, agents, CLI and MCP clients talk to one server, which runs the job queue and budget and dispatches work to a local GPU, cloud GPUs and AI services.">
        <div class="tier">
          <span class="tier-name">Clients</span>
          <div class="boxes">
            <span>Web app<small>Next.js, React, Three.js</small></span>
            <span>Agents<small>server-side</small></span>
            <span>CLI</span>
            <span>Claude Code, Codex, Cursor<small>through MCP</small></span>
          </div>
        </div>
        <div class="tier">
          <span class="tier-name">Server</span>
          <div class="boxes">
            <span class="wide">Python, FastAPI, SQLite<small>270 endpoints, job queue, budget control</small></span>
          </div>
        </div>
        <div class="tier">
          <span class="tier-name">Compute</span>
          <div class="boxes">
            <span>Local GPU<small>3D reconstruction, Neural Painter, segmentation</small></span>
            <span>Cloud GPUs<small>video models in ComfyUI on RunPod</small></span>
            <span>AI services<small>GPT Image, Kling, Seedance, Hailuo, ElevenLabs</small></span>
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-7) var(--space-6);
    display: grid;
    gap: var(--space-4);
  }

  .lede {
    max-width: 62ch;
  }

  .reel {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .reel video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    background: var(--paper-sunken);
  }

  .wrap > .facts {
    margin-top: var(--space-6);
  }

  .facts {
    display: grid;
    gap: var(--space-4) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(9rem, max-content));
    margin: 0;
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--space-1);
  }

  dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .stack-cell {
    grid-column: 1 / -1;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .section {
    padding-top: var(--space-8);
    display: grid;
    gap: var(--space-5);
  }

  .section > *,
  .chart-fig > *,
  .table-fig > * {
    min-width: 0;
  }

  .ts > :last-child {
    padding-bottom: var(--space-8);
  }

  .intro,
  .copy {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-4);
  }

  .copy p,
  .intro p {
    color: var(--ink-muted);
  }

  /* pipeline */
  .pipeline {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-3);
  }

  .pipeline li,
  .flow li {
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    padding: var(--space-4);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .step {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .pipeline h3,
  .flow h3 {
    font-size: var(--text-base);
  }

  .pipeline p,
  .flow p {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* 3D pairs */
  .pairs {
    margin: var(--space-3) 0 0;
    display: grid;
    gap: var(--space-3);
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .clip {
    position: relative;
  }

  .clip video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-sunken);
  }

  .tag {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius);
  }

  figcaption,
  caption {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .pairs figcaption,
  .flow-fig figcaption,
  .chart-fig figcaption,
  .table-fig figcaption {
    margin-top: var(--space-1);
    max-width: var(--measure);
  }

  /* agent flow */
  .flow-fig,
  .chart-fig,
  .table-fig {
    margin: var(--space-3) 0 0;
    display: grid;
    gap: var(--space-3);
  }

  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    counter-reset: flow;
  }

  .flow li {
    position: relative;
    counter-increment: flow;
  }

  .flow h3::before {
    content: counter(flow, decimal-leading-zero) "  ";
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--accent);
    white-space: pre;
  }

  /* bench chart */
  .chart {
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    padding: var(--space-5) var(--space-5) var(--space-4);
    --c-before: #80858d;
    --c-after: var(--accent);
  }

  :root[data-theme="dark"] .chart {
    --c-before: #6b7078;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-bottom: var(--space-4);
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .legend .dot {
    position: static;
    transform: none;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .rows li {
    display: grid;
    grid-template-columns: 13rem 1fr 7.5rem;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-1);
    border-radius: var(--radius);
  }

  .rows li:hover {
    background: var(--paper-sunken);
  }

  .name {
    font-size: var(--text-sm);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .name small {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .track {
    position: relative;
    height: 1.25rem;
    background: linear-gradient(var(--rule), var(--rule)) center / 100% 1px no-repeat;
  }

  .bar {
    position: absolute;
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
    background: var(--c-after);
    opacity: 0.55;
  }

  .dot {
    position: absolute;
    top: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 2px var(--paper-raised);
    display: inline-block;
  }

  .dot.before {
    background: var(--c-before);
  }

  .dot.after {
    background: var(--c-after);
  }

  .vals {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .vals strong {
    color: var(--ink);
    font-weight: 600;
  }

  .axis {
    display: flex;
    justify-content: space-between;
    margin-left: calc(13rem + var(--space-4));
    margin-right: calc(7.5rem + var(--space-4));
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  /* table */
  .table-fig table {
    width: 100%;
    max-width: 44rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .table-fig caption {
    text-align: left;
    padding-bottom: var(--space-2);
    color: var(--ink);
    font-weight: 600;
  }

  .table-fig th,
  .table-fig td {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--rule);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .table-fig th[scope="row"],
  .table-fig thead th:first-child {
    text-align: left;
    font-weight: 500;
  }

  .table-fig thead th {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 600;
  }

  .table-fig td {
    font-family: var(--font-mono);
    color: var(--ink-muted);
  }

  /* architecture */
  .arch {
    display: grid;
    gap: var(--space-3);
  }

  .tier {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-4);
    align-items: stretch;
    position: relative;
  }

  .tier + .tier::before {
    content: "";
