---
import BaseLayout from "../layouts/BaseLayout.astro";
import Figure from "../components/Figure.astro";
import Gallery from "../components/Gallery.astro";

import cutShot from "../assets/projects/ts-sequence.jpg";
import boardShot from "../assets/projects/ts-storyboard.jpg";
import setShot from "../assets/projects/ts-3d-set.jpg";
import libraryShot from "../assets/projects/ts-library.jpg";
import characterShot from "../assets/projects/ts-library-character.jpg";
import painterShot from "../assets/projects/ts-painter.jpg";

const stack = [
  "TypeScript", "Next.js / React", "Three.js", "Python", "FastAPI", "SQLite",
  "ComfyUI", "RunPod", "MapAnything", "Open3D", "SAM 3", "Stable Diffusion",
  "LTX-2.5", "MiniMax H3", "Wan 2.2", "ElevenLabs", "MCP",
];

const pipeline = [
  ["Script", "Written and revised with an AI model, then turned into a list of shots."],
  ["Storyboard", "Every shot gets its action, camera, length and a finished frame."],
  ["Characters", "Each character, place and prop is approved once and used in every shot."],
  ["3D", "Every location is built in 3D, with a camera for each shot."],
  ["Video", "The approved frame is animated on rented GPUs or through a video API. Price shown first, every version kept."],
  ["Sound", "Voices, music and effects, each on its own track."],
  ["Edit", "All shots cut together and exported as a film."],
];

const agentFlow = [
  ["Task", "You ask in plain words. The assistant writes down what to do and how to tell it is finished."],
  ["Check", "Every change is checked against the task. Touching another shot is refused."],
  ["Tools", "115 tools, the same actions a person has in the app."],
  ["Limits", "A cap on attempts and on money. If it goes round in circles, it stops and asks."],
  ["Second look", "A second AI model reviews the finished work and lists what is missing."],
  ["You decide", "Only a person approves a picture or a shot. Every change can be undone."],
];

// Agent bench: same task, same model, first run against the run after the changes to the assistant's tools and checks.
// Source: scripts/agent_bench (results.jsonl, 627 runs); tasks with a valid run before and after.
const bench = [
  { model: "Gemma 4 26B", n: 6, before: 0.13, after: 0.75 },
  { model: "Gemma 4 31B", n: 8, before: 0.42, after: 0.76 },
  { model: "gpt-oss-20b", n: 3, before: 0.38, after: 0.61 },
  { model: "Qwen3.5 9B, on a laptop", n: 3, before: 0.29, after: 0.42 },
  { model: "Qwen3.6 35B", n: 8, before: 0.62, after: 0.73 },
  { model: "Qwen3.8 27B", n: 4, before: 0.57, after: 0.65 },
  { model: "Qwen4 Max", n: 4, before: 0.65, after: 0.97 },
  { model: "GPT-6 Luna", n: 4, before: 0.62, after: 0.88 },
];

const latest = [
  { model: "GPT-6.1 Terra", tasks: 18, score: 0.86, usd: 0.262 },
  { model: "DeepSeek V4.1 Flash", tasks: 16, score: 0.83, usd: 0.042 },
  { model: "Qwen3.8 27B (open)", tasks: 36, score: 0.81, usd: 0.092 },
  { model: "Qwen4 Max", tasks: 14, score: 0.79, usd: 0.326 },
  { model: "GPT-6 Luna", tasks: 32, score: 0.76, usd: 0.081 },
  { model: "Gemma 4 31B (open)", tasks: 30, score: 0.73, usd: 0.082 },
  { model: "Qwen3.6 35B (open)", tasks: 21, score: 0.73, usd: 0.042 },
  { model: "gpt-oss-20b (open)", tasks: 18, score: 0.44, usd: 0.022 },
];

const pct = (v: number) => `${Math.round(v * 100)}%`;
---

<BaseLayout
  title="AI Film Studio"
  description="An app for making animated films with AI: script, storyboard, characters, 3D locations, video, sound and editing in one place, with an AI assistant that can do the same work."
  path="/ai-film-studio/"
>
  <article class="ts">
    <header class="wrap head">
      <p class="eyebrow">Own project</p>
      <h1>AI Film Studio</h1>
      <p class="lede">
        An app I built for making animated films with AI: script, storyboard, characters, 3D locations, video,
        sound and editing in one place.
      </p>
      <p class="lede">
        Agentic workflow over MCP: AI agents run the whole pipeline with the artist's own tools. They learn
        from the artists' work, keep every character consistent and get camera angles and layouts right.
        Built on my set extension research: a location rebuilt in 3D and shot from new angles.
      </p>
    </header>

    <div class="wrap">
      <figure class="reel">
        <video src="/figures/turbo-sandwich/reel.mp4" poster="/figures/turbo-sandwich/reel.jpg"
          autoplay muted loop playsinline preload="auto"
          aria-label="Shots from episode 1 of Wilson's Little World: a forest river, Plop the frog on his rock, Wilson the kitten, Hollis the rabbit, the two friends crossing the water."></video>
        <figcaption>
          Episode 1 of “Wilson's Little World”, an animated series made entirely in the app.
        </figcaption>
      </figure>

      <dl class="facts">
        <div><dt>App</dt><dd>Turbo Sandwich</dd></div>
        <div><dt>Role</dt><dd>Author, agent harness engineering</dd></div>
        <div><dt>Years</dt><dd>2026 – present</dd></div>
        <div><dt>Status</dt><dd>In daily use</dd></div>
        <div><dt>First film</dt><dd>“Wilson's Little World”, episode 1</dd></div>
        <div class="stack-cell"><dt>Stack</dt><dd class="stack">{stack.join(" · ")}</dd></div>
      </dl>
    </div>

    <section class="wrap section">
      <div class="copy">
        <h2>From a 3D layout to a finished shot</h2>
        <p>
          I block the camera move in 3D with simple figures. A video model draws the real shot from it, with the
          approved characters and location.
        </p>
      </div>
      <figure class="pairs">
        <div class="pair">
          <div class="clip">
            <span class="tag">3D layout</span>
            <video src="/figures/turbo-sandwich/orbit-3d.mp4" poster="/figures/turbo-sandwich/orbit-3d.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="A simple 3D layout: the camera goes half way round two figures standing on a forest path."></video>
          </div>
          <div class="clip">
            <span class="tag">Finished shot</span>
            <video src="/figures/turbo-sandwich/orbit-take.mp4" poster="/figures/turbo-sandwich/orbit-take.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="The same move drawn by MiniMax H3: the camera goes round the kitten and the rabbit and ends on the river behind them."></video>
          </div>
        </div>
        <div class="pair">
          <div class="clip">
            <span class="tag">3D layout</span>
            <video src="/figures/turbo-sandwich/walk-3d.mp4" poster="/figures/turbo-sandwich/walk-3d.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="A simple 3D layout: two figures walk along a path between trees, the camera following behind."></video>
          </div>
          <div class="clip">
            <span class="tag">Finished shot</span>
            <video src="/figures/turbo-sandwich/walk-take.mp4" poster="/figures/turbo-sandwich/walk-take.jpg"
              autoplay muted loop playsinline preload="metadata" aria-label="The same move drawn by MiniMax H3: the kitten and the rabbit walk along a forest path beside a river."></video>
          </div>
        </div>
        <figcaption>Left: the 3D layout. Right: the shot MiniMax H3 drew from it.</figcaption>
      </figure>
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Editing</h2>
        <p>
          An editor made for AI shots. Swap a clip for another version of the shot without moving its neighbours,
          start it where the movement starts, lay one clip over another with a painted mask. Dialogue, music and
          effects sit on their own tracks. The film exports as a video or as an edit list for Premiere and
          DaVinci Resolve.
        </p>
      </div>
      <Figure
        src={cutShot}
        alt="The editor with episode 1: video versions on the left, the player with Plop the frog in the middle, and a timeline with 100 clips over tracks for dialogue, music, background sound and effects."
        caption="The edit of episode 1: 100 clips, with dialogue, music, background sound and effects."
        full="/figures/turbo-sandwich/ts-sequence.jpg"
      />
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Why one app</h2>
        <p>
          AI video tools make single clips. A film needs the same characters in every shot, places that hold
          together when the camera turns, and cuts that work. Here every shot knows its line in the script, its
          approved frame, its video versions and its place in the edit.
        </p>
      </div>

      <ol class="pipeline" aria-label="The steps of making an episode">
        {pipeline.map(([name, text], i) => (
          <li>
            <span class="step">{String(i + 1).padStart(2, "0")}</span>
            <h3>{name}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Storyboard</h2>
        <p>
          The whole scene on one screen. A character facing the wrong way or two shots that are too alike get
          fixed in the still picture, before any video is paid for.
        </p>
      </div>
      <Figure
        src={boardShot}
        alt="The storyboard: twelve finished frames of episode 1 in a grid, each with its shot number, length, approval and a line of action."
        caption="Episode 1 on the storyboard: 113 shots, each frame approved before it is animated."
        full="/figures/turbo-sandwich/ts-storyboard.jpg"
      />
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Characters that stay the same</h2>
        <p>
          Each character, place and prop is approved once. That picture goes into every new frame, with a lineup
          that keeps their heights right.
        </p>
      </div>
      <Gallery
        items={[
          { src: libraryShot, alt: "The library of the series: the characters, two lineups and the location sketches." },
          { src: characterShot, alt: "Wilson the kitten in the library, with his 13 versions, the approved look and the pictures used to draw it." },
        ]}
        caption="The characters and locations of the series, and one character with every version."
      />
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Locations in 3D</h2>
        <p>
          Each location is rebuilt in 3D from its pictures, on my own GPU. Every shot gets a camera there: its
          render sets the layout of a new frame, the approved pictures set the look.
        </p>
      </div>
      <Figure
        src={setShot}
        alt="The 3D view through one of the shot cameras: a forest river bank with mossy stones, ferns and a sunlit path between the trees, with the camera's settings on the right."
        caption="The Gold River location in 3D, seen through one of the shot cameras."
        full="/figures/turbo-sandwich/ts-3d-set.jpg"
      />
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Fixing a frame by hand</h2>
        <p>
          A paint editor for small fixes before animation: layers, brushes, clone, masks and AI fill. Neural
          Painter redraws the picture live while you paint, on my own GPU.
        </p>
      </div>
      <Figure
        src={painterShot}
        alt="The paint editor with a frame of Wilson the kitten holding a magnifying glass by the river: tools and layers on the left, the Neural Painter panel on the right."
        caption="The paint editor on a frame from the series."
        full="/figures/turbo-sandwich/ts-painter.jpg"
      />
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>The AI assistant</h2>
        <p>
          The assistant does the same work a person does: sets up a 3D location, draws a frame, makes a video,
          looks at it and tries again. Claude Code, Codex and Cursor use the same tools through MCP. Rules
          written as code keep it on task:
        </p>
      </div>

      <figure class="flow-fig">
        <ol class="flow" aria-label="How the app keeps the assistant on task">
          {agentFlow.map(([name, text]) => (
            <li><h3>{name}</h3><p>{text}</p></li>
          ))}
        </ol>
        <figcaption>The model does the work. The app holds the task, checks each step and leaves the decisions to a person.</figcaption>
      </figure>
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>Which AI models can do the job</h2>
        <p>
          I tested 18 models on a copy of the real project with my everyday tasks: move a clip, place a line of
          dialogue, pick the usable videos, find the worst cuts, edit a 3D location. 627 runs in all. Where every
          model failed the same way, I fixed the app, not the prompt. Trimming old tool results and caching made
          each step up to 15 times cheaper.
        </p>
      </div>

      <figure class="chart-fig">
        <div class="chart" role="img" aria-label="Score of each model on the same tasks: the first run, and the run after the changes to the app. Over 45 repeated runs on 12 models, the average went from 44% to 73%.">
          <div class="legend" aria-hidden="true">
            <span><i class="dot before"></i>First run</span>
            <span><i class="dot after"></i>After the changes to the app</span>
          </div>
          <ul class="rows">
            {bench.map((b) => (
              <li title={`${b.model}: ${pct(b.before)} → ${pct(b.after)} over ${b.n} tasks`}>
                <span class="name">{b.model}<small>{b.n} tasks</small></span>
                <span class="track">
                  <span class="bar" style={`left:${b.before * 100}%;width:${(b.after - b.before) * 100}%`}></span>
                  <i class="dot before" style={`left:${b.before * 100}%`}></i>
                  <i class="dot after" style={`left:${b.after * 100}%`}></i>
                </span>
                <span class="vals"><span class="v-before">{pct(b.before)}</span> → <strong>{pct(b.after)}</strong></span>
              </li>
            ))}
          </ul>
          <div class="axis" aria-hidden="true"><span>0%</span><span>50%</span><span>100%</span></div>
        </div>
        <figcaption>
          Same model, same tasks, before and after. On average 44% → 73%; the weakest models gained the most.
        </figcaption>
      </figure>

      <figure class="table-fig">
        <table>
          <caption>Final results (latest run of each task)</caption>
          <thead>
            <tr><th scope="col">Model</th><th scope="col">Tasks</th><th scope="col">Score</th><th scope="col">Cost per task</th></tr>
          </thead>
          <tbody>
            {latest.map((r) => (
              <tr>
                <th scope="row">{r.model}</th>
                <td>{r.tasks}</td>
                <td>{pct(r.score)}</td>
                <td>${r.usd.toFixed(3)}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <figcaption>
          Cheap and open models come within a few points of the best one at a third to a sixth of the price.
        </figcaption>
      </figure>
    </section>

    <section class="wrap section">
      <div class="copy">
        <h2>How it is built</h2>
      </div>
      <div class="arch" role="img" aria-label="How it is built: the app in the browser, the AI assistant, a command line and outside AI apps all talk to one server, which runs the queue and the budget and sends work to my own GPU, to rented GPUs and to AI services.">
        <div class="tier">
          <span class="tier-name">Who uses it</span>
          <div class="boxes">
            <span>The app in the browser<small>Next.js, React, Three.js</small></span>
            <span>The AI assistant<small>runs on the server</small></span>
            <span>Command line</span>
            <span>Claude Code, Codex, Cursor<small>through MCP</small></span>
          </div>
        </div>
        <div class="tier">
          <span class="tier-name">Server</span>
          <div class="boxes">
            <span class="wide">Python, FastAPI, SQLite<small>about 270 API endpoints, one queue for all jobs, the spending limit, a database per project</small></span>
          </div>
        </div>
        <div class="tier">
          <span class="tier-name">Where it runs</span>
          <div class="boxes">
            <span>My own GPU<small>3D rebuilding, Neural Painter, object masks, voices</small></span>
            <span>Rented GPUs on RunPod<small>video models in ComfyUI</small></span>
            <span>AI services<small>GPT Image, Kling, Seedance, Hailuo, ElevenLabs</small></span>
          </div>
        </div>
      </div>
      <ul class="notes">
        <li>Account keys stay on the server. The browser and the rented machines never see them.</li>
        <li>The app's docs are the assistant's knowledge: it reads them fresh for every question.</li>
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-7) var(--space-6);
    display: grid;
    gap: var(--space-4);
  }

  .lede {
    max-width: 62ch;
  }

  .reel {
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }

  .reel video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    background: var(--paper-sunken);
  }

  .wrap > .facts {
    margin-top: var(--space-6);
  }

  .facts {
    display: grid;
    gap: var(--space-4) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(9rem, max-content));
    margin: 0;
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--space-1);
  }

  dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .stack-cell {
    grid-column: 1 / -1;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .section {
    padding-top: var(--space-8);
    display: grid;
    gap: var(--space-5);
  }

  .section > *,
  .chart-fig > *,
  .table-fig > * {
    min-width: 0;
  }

  .ts > :last-child {
    padding-bottom: var(--space-8);
  }

  .intro,
  .copy {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-4);
  }

  .copy p,
  .intro p {
    color: var(--ink-muted);
  }

  /* pipeline */
  .pipeline {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-3);
  }

  .pipeline li,
  .flow li {
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    padding: var(--space-4);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .step {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .pipeline h3,
  .flow h3 {
    font-size: var(--text-base);
  }

  .pipeline p,
  .flow p {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* 3D pairs */
  .pairs {
    margin: var(--space-3) 0 0;
    display: grid;
    gap: var(--space-3);
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .clip {
    position: relative;
  }

  .clip video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-sunken);
  }

  .tag {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius);
  }

  figcaption,
  caption {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .pairs figcaption,
  .flow-fig figcaption,
  .chart-fig figcaption,
  .table-fig figcaption {
    margin-top: var(--space-1);
    max-width: var(--measure);
  }

  /* agent flow */
  .flow-fig,
  .chart-fig,
  .table-fig {
    margin: var(--space-3) 0 0;
    display: grid;
    gap: var(--space-3);
  }

  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    counter-reset: flow;
  }

  .flow li {
    position: relative;
    counter-increment: flow;
  }

  .flow h3::before {
    content: counter(flow, decimal-leading-zero) "  ";
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--accent);
    white-space: pre;
  }

  /* bench chart */
  .chart {
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--paper-raised);
    padding: var(--space-5) var(--space-5) var(--space-4);
    --c-before: #80858d;
    --c-after: var(--accent);
  }

  :root[data-theme="dark"] .chart {
    --c-before: #6b7078;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-bottom: var(--space-4);
  }

  .legend span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .legend .dot {
    position: static;
    transform: none;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .rows li {
    display: grid;
    grid-template-columns: 13rem 1fr 7.5rem;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-1);
    border-radius: var(--radius);
  }

  .rows li:hover {
    background: var(--paper-sunken);
  }

  .name {
    font-size: var(--text-sm);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .name small {
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .track {
    position: relative;
    height: 1.25rem;
    background: linear-gradient(var(--rule), var(--rule)) center / 100% 1px no-repeat;
  }

  .bar {
    position: absolute;
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
    background: var(--c-after);
    opacity: 0.55;
  }

  .dot {
    position: absolute;
    top: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 2px var(--paper-raised);
    display: inline-block;
  }

  .dot.before {
    background: var(--c-before);
  }

  .dot.after {
    background: var(--c-after);
  }

  .vals {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .vals strong {
    color: var(--ink);
    font-weight: 600;
  }

  .axis {
    display: flex;
    justify-content: space-between;
    margin-left: calc(13rem + var(--space-4));
    margin-right: calc(7.5rem + var(--space-4));
