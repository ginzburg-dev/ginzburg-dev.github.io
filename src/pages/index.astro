---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { site } from "../data/site";
import gdResults from "../assets/projects/gd-denoising-results-grid.jpg";
import gndLion from "../assets/projects/gnd-noise-to-clean.jpg";
import r4dTrain from "../assets/projects/r4d-train.jpg";
import ncCover from "../assets/projects/nc-cover.jpg";
import cvPitchtrack from "../assets/projects/cv-pitchtrack.jpg";
import cvVisionops from "../assets/projects/cv-visionops.jpg";
import cvSceneslam from "../assets/projects/cv-sceneslam.jpg";
import paperFigure from "../assets/research/cvmp-figure-1.png";
import { paper } from "../data/research";

const projects = await getCollection("projects");
const byId = Object.fromEntries(projects.map((p) => [p.id, p]));

/** Featured projects, in the order they should be read. */
const featured = [
  {
    entry: byId["neural-composer"],
    thumb: ncCover,
    thumbCredit: "Strawberry capture by Dany Bittel, CC BY 4.0",
    thumbAlt:
      "Neural Composer's viewer showing a rendered Gaussian splat strawberry on a checkerboard, above a node graph with ReadGeo, TransformGeo, Scene, Camera and ScanlineRender nodes.",
    blurb:
      "Node-based compositing software with machine learning built into the graph: SAM roto, ViTMatte, diffusion, ComfyUI and Gaussian splats next to keying, cleanup and tracking.",
    meta: "In development · Python · Qt · OpenGL · PyTorch",
  },
  {
    entry: byId["radiance4d"],
    thumb: r4dTrain,
    thumbCredit: "Splats: INRIA 3DGS <i>train</i> (Tanks and Temples), rendered in Radiance4D",
    thumbAlt:
      "A green Western Pacific 713 locomotive head-on on a sunny rail yard, with other carriages beside it, rendered from Gaussian splats.",
    blurb:
      "A real-time renderer for Gaussian splats and meshes, for virtual production, AR/VR and synthetic training data for robots and self-driving cars. It draws a million splats at 1080p in 9.7 ms.",
    meta: "In development · C++20 · Direct3D 12 · Vulkan · HLSL",
  },
  {
    entry: byId["ginzburg-neural-denoiser"],
    thumb: gndLion,
    thumbCredit: "Image by Joanna Kobierska",
    thumbAlt:
      "Close-up of a furred animal head, split down the middle: the noisy low-sample render on the left, the denoised result on the right.",
    blurb:
      "Learned temporal denoising for rendered sequences, with a PyTorch training pipeline and a standalone C++/CUDA inference engine.",
    meta: "2024–present · PyTorch · CUDA · C++",
  },
  {
    entry: byId["ginzburg-denoiser"],
    thumb: gdResults,
    thumbAlt:
      "Three before-and-after comparisons showing noisy material, fur and hair beside the Ginzburg Denoiser results.",
    blurb:
      "Deterministic spatiotemporal denoising for path-traced animation, deployed in production as standalone software, a Nuke plug-in and a C++/Python API.",
    meta: "2016–2020 · C++ · Python",
  },
];

/** Computer vision work, shown as a compact row under the featured projects. */
const vision = [
  {
    title: "PitchTrack",
    thumb: cvPitchtrack,
    thumbAlt:
      "A night football match with each player in a coloured box labelled with a persistent track ID.",
    credit: "Footage: Luis Quintero, Pexels",
    blurb:
      "Football video analytics: detects and tracks every player in a moving-camera shot and maps them onto the pitch, only where the camera calibration can be trusted.",
    meta: "Python · YOLO11 · OpenCV",
    repo: "https://github.com/ginzburg-dev/pitchtrack",
  },
  {
    title: "VisionOps",
    thumb: cvVisionops,
    thumbAlt:
      "A busy waterfront walkway with twenty people detected, each in a labelled box, and a person count banner.",
    credit: "Footage: Sururi Ballıdağ, Pexels",
    blurb:
      "A complete computer vision pipeline for counting people in video: from raw footage and reviewed labels to a trained model running as a web service.",
    meta: "Python · YOLO11 · ONNX Runtime · FastAPI",
    repo: "https://github.com/ginzburg-dev/visionops",
  },
  {
    title: "SceneSLAM",
    thumb: cvSceneslam,
    thumbAlt:
      "A coloured point-cloud reconstruction of an office room with the estimated camera trajectory drawn in orange.",
    credit: "TUM RGB-D dataset, CC BY 4.0",
    blurb:
      "Camera tracking and 3D reconstruction from a depth camera, in C++. It tracks all 1,359 frames of a handheld room scan at 30 ms per frame on a laptop CPU.",
    meta: "C++20 · OpenCV · Rerun",
    repo: "https://github.com/ginzburg-dev/scene-slam",
  },
];
---

<BaseLayout title={site.name} description={site.description} path="/">
  <div class="page">
    <section class="intro">
      <div class="intro-text">
        <h1>{site.name}</h1>
        <p class="title">Software Engineer</p>
        <p class="bio">
          I develop performance-critical software in C++, CUDA and Python across
          machine learning, computer graphics, image and video processing, and
          backend engineering. My work includes training machine-learning models,
          building optimised GPU inference engines, and developing software for
          3D reconstruction and tracking. I'm currently building a renderer for
          virtual production and synthetic data generation for robotics and
          autonomous driving.
        </p>
        <p class="links">
          <span>{site.location}</span>
          <span class="sep">·</span>
          <a href={site.links.github}>GitHub</a>
          <span class="sep">·</span>
          <a href={site.links.linkedin}>LinkedIn</a>
          <span class="sep">·</span>
          <a href={`mailto:${site.email}`}>Email</a>
        </p>
      </div>
    </section>

    <section class="block">
      <h2>Selected Projects</h2>
      <ul class="entries">
        {
          featured.map((item) => (
            <li class="entry">
              <div class="thumb-col">
                <a class="thumb" href={`/projects/${item.entry.id}/`}>
                  <Image
                    src={item.thumb}
                    alt={item.thumbAlt}
                    widths={[320, 640, 960]}
                    sizes="(min-width: 38rem) 17rem, 20rem"
                    quality={86}
                  />
                </a>
                {item.thumbCredit && <p class="credit" set:html={item.thumbCredit} />}
              </div>
              <div class="body">
                <h3>
                  <a href={`/projects/${item.entry.id}/`}>
                    {item.entry.data.title}
                  </a>
                </h3>
                <p class="blurb">{item.blurb}</p>
                <p class="entry-meta">{item.meta}</p>
                <p class="entry-links">
                  <a href={`/projects/${item.entry.id}/`}>Details</a>
                  {item.entry.data.repo && (
                    <a href={item.entry.data.repo}>Code</a>
                  )}
                  {item.entry.data.video && (
                    <a href={item.entry.data.video}>Video</a>
                  )}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="more"><a href="/projects/">All projects →</a></p>
    </section>

    <section class="block">
      <h2>Computer Vision</h2>
      <ul class="cv-grid">
        {
          vision.map((item) => (
            <li class="cv-card">
              <a class="thumb" href={item.repo}>
                <Image
                  src={item.thumb}
                  alt={item.thumbAlt}
                  widths={[320, 640]}
                  sizes="(min-width: 50rem) 15rem, (min-width: 38rem) 30vw, 100vw"
                  quality={86}
                />
              </a>
              <p class="credit">{item.credit}</p>
              <h3><a href={item.repo}>{item.title}</a></h3>
              <p class="cv-blurb">{item.blurb}</p>
              <p class="entry-meta">{item.meta}</p>
              <p class="entry-links"><a href={item.repo}>Code</a></p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <h2>Research</h2>
      <span class="paper-kind">Research paper</span>
      <p class="paper-title">{paper.title}</p>
      <p class="line">{paper.venue} · {paper.status}</p>
      <a class="research-cover" href="/research/">
        <Image
          src={paperFigure}
          alt={paper.figureAlt}
          widths={[640, 960, 1440]}
          sizes="(min-width: 50rem) 50rem, calc(100vw - 2rem)"
          quality={88}
        />
      </a>
      <p class="more"><a href="/research/">View research →</a></p>
    </section>

  </div>
</BaseLayout>

<style>
  .page {
    width: 100%;
    max-width: 50rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-8) var(--space-7);
  }

  /* intro ---------------------------------------------------------------- */

  .intro {
    margin-bottom: var(--space-8);
  }

  h1 {
    font-size: var(--text-3xl);
    letter-spacing: -0.018em;
  }

  .title {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    margin-top: var(--space-1);
  }

  .bio {
    margin-top: var(--space-4);
    max-width: 60ch;
  }

  .links {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
  }

  .sep {
    color: var(--ink-faint);
  }

  /* sections ------------------------------------------------------------- */

  .block + .block {
    margin-top: var(--space-8);
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 620;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-5);
  }

  /* project entries: thumbnail left, text right -------------------------- */

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  .entry {
    display: grid;
    grid-template-columns: 17rem 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .thumb {
    display: block;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--paper-raised);
    aspect-ratio: 16 / 9;
  }

  .thumb:hover {
    border-color: var(--rule-strong);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .credit {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .body h3 {
    font-size: var(--text-lg);
    font-weight: 620;
    line-height: 1.3;
  }

  .body h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .body h3 a:hover {
    color: var(--accent);
  }

  .blurb {
    margin-top: var(--space-2);
    font-size: var(--text-base);
    color: var(--ink-muted);
  }

  .entry-meta {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
  }

  .entry-links {
    margin-top: var(--space-3);
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }

  @media (max-width: 38rem) {
    .entry {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .thumb-col {
      max-width: 20rem;
    }
  }

  /* computer vision: three compact cards --------------------------------- */

  .cv-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .cv-card h3 {
    margin-top: var(--space-3);
    font-size: var(--text-base);
    font-weight: 620;
  }

  .cv-card h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .cv-card h3 a:hover {
    color: var(--accent);
  }

  .cv-blurb {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  @media (max-width: 38rem) {
    .cv-grid {
      grid-template-columns: 1fr;
    }
  }

  /* research, experience, writing ---------------------------------------- */

  .paper-title {
    margin-top: var(--space-2);
    font-weight: 550;
    max-width: 52ch;
  }

  .paper-kind {
    display: inline-block;
    padding: 0.16em 0.55em;
    border: 1px solid color-mix(in srgb, var(--status-research) 32%, transparent);
    border-radius: var(--radius);
    color: var(--status-research);
    background: color-mix(
      in srgb,
      var(--status-research-bg) 78%,
      transparent
    );
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .research-cover {
    display: block;
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    background: white;
  }

  .research-cover:hover {
    border-color: var(--rule-strong);
  }

  .research-cover :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .line {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .paper-title + .line {
    margin-top: var(--space-1);
  }









  .more {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }
</style>
