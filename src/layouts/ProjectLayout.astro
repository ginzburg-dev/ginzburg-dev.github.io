---
import BaseLayout from "./BaseLayout.astro";
import StatusBadge from "../components/StatusBadge.astro";
import type { Status } from "../components/StatusBadge.astro";

interface Props {
  title: string;
  description: string;
  summary: string;
  years?: string;
  role: string;
  status: Status;
  stack: string[];
  repo?: string;
  video?: string;
  path?: string;
}

const {
  title,
  description,
  summary,
  years,
  role,
  status,
  stack,
  repo,
  video,
  path,
} = Astro.props;
---

<BaseLayout title={title} description={description} path={path}>
  <article>
    <header class="wrap head">
      <p class="eyebrow"><a href="/projects/">Projects</a></p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>

      <dl class="facts">
        {
          years && (
            <div>
              <dt>Years</dt>
              <dd>{years}</dd>
            </div>
          )
        }
        <div>
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd><StatusBadge status={status} /></dd>
        </div>
        <div class="stack-cell">
          <dt>Stack</dt>
          <dd class="stack">{stack.join(" · ")}</dd>
        </div>
      </dl>

      {
        (repo || video) && (
          <p class="links">
            {repo && (
              <a href={repo} target="_blank" rel="noopener">
                Source code
              </a>
            )}
            {video && (
              <a href={video} target="_blank" rel="noopener">
                Watch results
              </a>
            )}
          </p>
        )
      }
    </header>

    <div class="measure prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: var(--space-7) var(--space-6);
    display: grid;
    gap: var(--space-4);
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--accent);
  }

  .lede {
    max-width: 62ch;
  }

  .facts {
    display: grid;
    gap: var(--space-4) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(9rem, max-content));
    margin: 0;
    padding-block: var(--space-4);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--space-1);
  }

  dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .stack-cell {
    grid-column: 1 / -1;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .links {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
    font-size: var(--text-sm);
  }

  .prose {
    padding-bottom: var(--space-7);
  }
</style>
